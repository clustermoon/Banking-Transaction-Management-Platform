@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <h1>Your Financial Future, Our Priority</h1>
        <p class="lead mb-4">Secure. Simple. Built for you.</p>
        <a class="btn btn-primary btn-lg me-2" href="#">Open An Account</a>
        <a class="btn btn-outline-primary btn-lg" href="#features">Learn More</a>
    </div>
</section>

<section id="features" class="features">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-6 col-lg-3">
                <img class="feature_icon" src="~/images/SecureSignIn.svg" />
                <h2 class="h5">Secure Sign in</h2>
                <p>Your Data is protected with industry-standard sevurity.</p>
            </div>
            <div class="col-md-6 col-lg-3">
                <img class="feature_icon" src="~/images/CheckingSaving.svg" />
                <h2 class="h5">Checking and Savings</h2>
                <p>Open and store your finances with individual checking and savings accounts.</p>
            </div>
            <div class="col-md-6 col-lg-3">
                <img class="feature_icon" src="~/images/MoveMoney.svg" />
                <h2 class="h5">Move Money</h2>
                <p>Deposit, Withdraw, and transfer with just a few clicks.</p>
            </div>
            <div class="col-md-6 col-lg-3">
                <img class="feature_icon" src="~/images/Statement.svg" />
                <h2 class="h5">Statements and History</h2>
                <p>Track your transactions and manage your finances.</p>
            </div>
        </div>
    </div>
</section>

<section class="showcase">
    <div class="row g-0">
        <div class="col-lg-5">
            <img class="showcase-img" src="~/images/laptop.jpg" alt="Computer and coffee" />
        </div>
        <div class="col-lg-7 d-flex align-items-center">
            <div class="p-5">
                <h2>Modern Banking. Made simple.</h2>
                <p>Whether you're saving for tomorrow or managing your daily expenses, Avenor Bank gives you the tools you need.'</p>
                <a class="btn btn-primary" href="#">Open an account</a>
            </div>
        </div>
    </div>
</section>
