@model int
@{
    var notFound = Model == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}

<div class="page-surface">
    <div class="container page-content text-center">
        <span class="icon-tile">
            <i class="bi @(notFound ? "bi-compass" : "bi-exclamation-triangle")" aria-hidden="true"></i>
        </span>
        <h1 class="page-title">@(notFound ? "We couldn't find that page." : "Something went wrong.")</h1>
        <p class="page-subtitle">
            @(notFound ? "Check the address, or head back to somewhere familiar." : "Please try again in a moment.")
        </p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Avenor</a>
    </div>
</div>
