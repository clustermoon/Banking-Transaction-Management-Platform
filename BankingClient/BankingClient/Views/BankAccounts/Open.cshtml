@model OpenAccountViewModel
@{
    ViewData["Title"] = "Open an account";
}

<div class="page-surface">
    <div class="container page-content">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb-trail">
                <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li aria-current="page">Open account</li>
            </ol>
        </nav>

        <h1 class="page-title">Open an account</h1>
        <p class="page-subtitle">Choose an account type and give it a name you'll recognize.</p>

        <div class="row">
            <div class="col-lg-7">
                <div class="panel panel-body">
                    <form asp-action="Open" method="post" novalidate>
                        <partial name="_FormAlert" />

                        <fieldset class="form-field">
                            <legend class="form-label">Account type</legend>
                            <div class="choice-group">
                                <label class="choice-card">
                                    <input class="form-check-input" type="radio" asp-for="Type" value="Checking" />
                                    <span>
                                        <span class="choice-title">Checking</span>
                                        <span class="choice-text">For everyday spending and bills.</span>
                                    </span>
                                </label>
                                <label class="choice-card">
                                    <input class="form-check-input" type="radio" asp-for="Type" value="Savings" />
                                    <span>
                                        <span class="choice-title">Savings</span>
                                        <span class="choice-text">For setting money aside.</span>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="Type" class="field-error"></span>
                        </fieldset>

                        <div class="form-field">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="For example, Everyday Checking" maxlength="50" />
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-submit">
                            Open account
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
