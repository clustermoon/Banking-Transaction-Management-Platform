@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-surface">
    <div class="container page-content text-center">
        <span class="icon-tile"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
        <h1 class="page-title">Something went wrong.</h1>
        <p class="page-subtitle">We couldn't complete that request. Please try again in a moment.</p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="field-help mb-4">Reference: <code>@Model.RequestId</code></p>
        }

        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Avenor</a>
    </div>
</div>
