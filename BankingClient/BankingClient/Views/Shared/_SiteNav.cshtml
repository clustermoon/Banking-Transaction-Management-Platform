@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    bool IsController(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
    bool IsAction(string name) => string.Equals(action, name, StringComparison.OrdinalIgnoreCase);
}

@if (User.Identity?.IsAuthenticated == true)
{
    if (User.IsInRole(ClientRoles.Admin))
    {
        var onAccounts = IsController("Admin") && !IsAction("Audit");
        var onAudit = IsController("Admin") && IsAction("Audit");

        <a class="site-nav-link @(onAccounts ? "active" : null)" aria-current="@(onAccounts && IsAction("Accounts") ? "page" : null)"
           asp-controller="Admin" asp-action="Accounts">Accounts</a>
        <a class="site-nav-link @(onAudit ? "active" : null)" aria-current="@(onAudit ? "page" : null)"
           asp-controller="Admin" asp-action="Audit">Audit log</a>
    }
    else
    {
        var onOpenAccount = IsController("BankAccounts") && IsAction("Open");
        var onDashboard = IsController("Dashboard") || (IsController("BankAccounts") && !onOpenAccount);

        <a class="site-nav-link @(onDashboard ? "active" : null)" aria-current="@(IsController("Dashboard") ? "page" : null)"
           asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <a class="site-nav-link @(onOpenAccount ? "active" : null)" aria-current="@(onOpenAccount ? "page" : null)"
           asp-controller="BankAccounts" asp-action="Open">Open account</a>
    }

    <a class="site-nav-link @(IsController("Profile") ? "active" : null)" aria-current="@(IsController("Profile") ? "page" : null)"
       asp-controller="Profile" asp-action="Index">
        <i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity.Name
    </a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-light">Log out</button>
    </form>
}
else
{
    <a class="site-nav-link" asp-controller="Home" asp-action="Index">Home</a>
    <a class="site-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a>
    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create Account</a>
}
