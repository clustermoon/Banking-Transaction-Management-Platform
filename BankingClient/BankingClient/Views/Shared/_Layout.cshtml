<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Avenor Bank</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="d-flex flex-wrap align-items-center gap-3 py-3 px-4" aria-label="Main">
            <a class="brand d-flex align-items-center gap-2 me-auto" asp-controller="Home" asp-action="Index">
                <img src="~/images/bank-logo.svg" alt="" width="40" height="40" />
                Avenor
            </a>
            <partial name="_SiteNav" />
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer-inner">
            <span class="brand">Avenor</span>
            <span>© 2026 David Womack</span>
            <span>Portfolio demo. Not a real bank, and no real money moves.</span>
        </div>
    </footer>
</body>
</html>
